# انسخ هذا الملف إلى .env وضع مفتاح API الحقيقي على جهاز الخادم فقط.
OPENAI_API_KEY=ضع_مفتاحك_هنا

# يمكن تغيير النماذج عند الحاجة أو حسب ما يتاح لحساب API.
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=https://studio.penguinmod.com
